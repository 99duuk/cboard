Screen {
    background: #10151e;
    color: #e4eaf3;
}
#title { height: 2; padding: 0 2; color: #67d5ef; text-style: bold; }
#controls { height: 3; padding: 0 1; }
#account { width: 22; margin-right: 1; }
#status { width: 19; margin-right: 1; }
#search { width: 1fr; }
#workspace-controls { height: 3; padding: 0 1; }
#workspace-hint { width: 12; height: 3; content-align: left middle; color: #afbed1; }
#workspace-current { width: 1fr; height: 3; padding: 0 1; background: #1e3549; border-left: thick #67d5ef; text-wrap: nowrap; text-overflow: ellipsis; }
#workspace { width: 26; margin-left: 1; }
#workspace SelectCurrent #label { text-wrap: nowrap; text-overflow: ellipsis; }
#counts { height: auto; min-height: 2; max-height: 3; padding: 0 2; color: #afbed1; }
#body { height: 1fr; padding: 0 1; }
#tasks { width: 58%; height: 100%; background: #10151e; overflow-x: hidden; scrollbar-gutter: stable; }
DataTable > .datatable--header { background: #192332; color: #afbed1; }
DataTable > .datatable--cursor { background: #234d69; color: #ffffff; }
#detail { width: 42%; padding: 1 2; border-left: solid #2b3b51; }
#task-info { height: auto; color: #e4eaf3; margin-bottom: 1; }
#messages { background: #10151e; padding: 0; }
#health { height: auto; max-height: 3; padding: 0 2; }
Footer { background: #192332; }
Screen.compact #body { layout: vertical; }
Screen.compact #tasks { width: 100%; height: 100%; }
Screen.compact #detail { display: none; width: 100%; height: 100%; border-left: none; padding: 0 1; }
Screen.compact.detail-only #tasks { display: none; }
Screen.compact.detail-only #detail { display: block; }
ResumeScreen { align: center middle; background: #000000 65%; }
#resume-dialog { width: 80%; max-width: 100; height: 80%; border: round #67d5ef; background: #192332; padding: 1 2; }
#resume-title { height: 2; text-style: bold; color: #67d5ef; }
#resume-list { height: 1fr; }
#resume-list Static { margin-bottom: 1; }
#resume-note { height: auto; color: #afbed1; margin: 1 0; }
#resume-buttons { height: 3; align-horizontal: center; }
#resume-buttons Button { margin-right: 1; }
#resume-buttons Button:focus { background: #234d69; color: #ffffff; text-style: bold; border: tall #67d5ef; }
RenameScreen { align: center middle; background: #000000 65%; }
#rename-dialog { width: 80%; max-width: 100; height: auto; border: round #67d5ef; background: #192332; padding: 1 2; }
#rename-title { height: 2; text-style: bold; color: #67d5ef; }
#rename-dialog Static { height: auto; }
#rename-name { margin: 1 0; }
#rename-note { color: #afbed1; margin-bottom: 1; }
#rename-buttons { height: 3; align-horizontal: center; }
#rename-buttons Button { margin-right: 1; }
DeleteScreen { align: center middle; background: #000000 65%; }
#delete-dialog { width: 80%; max-width: 100; height: 80%; max-height: 28; border: round #ec8597; background: #192332; padding: 1 2; }
#delete-title { height: 2; text-style: bold; color: #ec8597; }
#delete-description { height: 1fr; }
#delete-dialog Static { height: auto; }
#delete-warning { margin: 1 0; color: #ec8597; }
#delete-note { color: #afbed1; }
#delete-buttons { height: 3; align-horizontal: center; }
#delete-buttons Button { margin-right: 1; }
#delete-buttons Button:focus { background: #234d69; color: #ffffff; text-style: bold; border: tall #ec8597; }
