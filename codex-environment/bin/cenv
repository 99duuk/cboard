#!/usr/bin/env python3
import sys
from pathlib import Path
if sys.version_info < (3, 11):
    raise SystemExit('cenv requires Python 3.11 or newer; select a supported python3 in PATH')
sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from codex_env.cli import main
raise SystemExit(main())
